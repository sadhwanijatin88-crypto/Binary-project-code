        "from langdetect import DetectorFactory, detect, detect_langs\n",
        "from langdetect.lang_detect_exception import LangDetectException\n",
        "\n",
        "# Enforce deterministic results (seeds the detector)\n",
        "DetectorFactory.seed = 0\n",
        "\n",
        "# Common ISO 639-1 language code mapping\n",
        "LANGUAGE_NAMES = {\n",
        "    \"en\": \"English\",\n",
        "    \"es\": \"Spanish\",\n",
        "    \"fr\": \"French\",\n",
        "    \"de\": \"German\",\n",
        "    \"it\": \"Italian\",\n",
        "    \"pt\": \"Portuguese\",\n",
        "    \"nl\": \"Dutch\",\n",
        "    \"ru\": \"Russian\",\n",
        "    \"zh-cn\": \"Chinese (Simplified)\",\n",
        "    \"zh-tw\": \"Chinese (Traditional)\",\n",
        "    \"ja\": \"Japanese\",\n",
        "    \"ko\": \"Korean\",\n",
        "    \"ar\": \"Arabic\",\n",
        "    \"hi\": \"Hindi\",\n",
        "    \"bn\": \"Bengali\",\n",
        "    \"tr\": \"Turkish\",\n",
        "}\n",
        "\n",
        "\n",
        "def identify_language(text: str) -> None:\n",
        "    text = text.strip()\n",
        "    if not text:\n",
        "        print(\"Please enter valid text.\")\n",
        "        return\n",
        "\n",
        "    try:\n",
        "        # Detect primary language code\n",
        "        primary_code = detect(text)\n",
        "        primary_name = LANGUAGE_NAMES.get(primary_code, primary_code.upper())\n",
        "\n",
        "        # Retrieve confidence probabilities\n",
        "        probabilities = detect_langs(text)\n",
        "\n",
        "        print(\"-\" * 40)\n",
        "        print(f\"Input Text: \\\"{text}\\\"\")\n",
        "        print(f\"Detected Language: {primary_name} ({primary_code})\")\n",
        "        print(\"Confidence Breakdown:\")\n",
        "        for pred in probabilities:\n",
        "            name = LANGUAGE_NAMES.get(pred.lang, pred.lang.upper())\n",
        "            print(f\"  • {name}: {pred.prob * 100:.2f}%\")\n",
        "        print(\"-\" * 40)\n",
        "\n",
        "    except LangDetectException:\n",
        "        print(\"Could not detect any recognizable language features.\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    samples = [\n",
        "        \"Artificial intelligence is transforming software engineering.\",\n",
        "        \"Bonjour tout le monde, comment allez-vous aujourd'hui?\",\n",
        "        \"Guten Tag! Wie geht es Ihnen?\",\n",
        "        \"नमस्ते, आप कैसे हैं?\",\n",
        "        \"El aprendizaje automático es una rama de la inteligencia artificial.\",\n",
        "    ]\n",
        "\n",
        "    print(\"Running test samples:\\n\")\n",
        "    for sample in samples:\n",
        "        identify_language(sample)\n",
        "\n",
        "    # Interactive Loop\n",
        "    print(\"\\nInteractive Mode (type 'exit' to quit):\")\n",
        "    while True:\n",
        "        user_input = input(\"\\nEnter text: \")\n",
        "        if user_input.lower() == \"exit\":\n",
        "            break\n",
        "        identify_language(user_input)"
      ],
